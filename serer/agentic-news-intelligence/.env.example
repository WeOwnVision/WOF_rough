DATABASE_URL=postgresql://dev_user:dev_password123@localhost:5432/rss_intelligence
INGESTION_SECRET=your_ingestion_secret_here

# --- ENRICHMENT PIPELINE ---
# nano (default): Nebius only, no local model. FAST_MODEL decides on-topic,
#   NVIDIA Nemotron-3-Nano writes the summary and picks taxonomy labels
#   (llm_enrichment.py). Needs the Nebius settings below (OPTION B).
# hybrid: local Laya SLM triage + FAST_MODEL (the original pipeline).
ENRICHMENT_ENGINE=nano
NANO_CONCURRENCY=4
# SUMMARY_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# TAG_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
LAYA_CONFIDENCE_THRESHOLD=0.65
LAYA_ON_TOPIC_THRESHOLD=0.40

# --- EMBEDDINGS (embedder.py) ---
# nebius (default): Qwen/Qwen3-Embedding-8B via the Nebius settings below, multilingual.
# local: sentence-transformers/all-MiniLM-L6-v2 on this machine (384 dims, English only).
# After changing backend or dimension run: python migrate_embeddings.py --rebuild
EMBEDDING_BACKEND=nebius
EMBEDDING_DIM=1024

# --- OPTION A: LOCAL LM STUDIO / OLLAMA (Local Development) ---
AI_BASE_URL=http://localhost:1234/v1
AI_API_KEY=lm-studio
FAST_MODEL=meta-llama-3.1-8b-instruct
REASONING_MODEL=meta-llama-3.1-8b-instruct

# --- OPTION B: NEBIUS STUDIO (NVIDIA Nemotron / Cloud Production) ---
# AI_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# AI_API_KEY=your_nebius_api_key_here
# FAST_MODEL=meta-llama/llama-3.1-8b-instruct
# REASONING_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# --- OPTION C: OPENAI CLOUD ---
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=your_actual_api_key_here
# FAST_MODEL=gpt-4o-mini
# REASONING_MODEL=gpt-4o

# --- TAVILY LIVE WEB & FACT-CHECKING ENGINE ---
TAVILY_API_KEY=tvly-YOUR_ACTUAL_API_KEY_HERE
# Optional: several keys, comma separated. When one runs out of plan credits the
# next one takes over automatically (overrides TAVILY_API_KEY when set).
# TAVILY_API_KEYS=tvly-key-one,tvly-key-two
TAVILY_PROJECT=agentic-news-intelligence
TAVILY_SEARCH_DEPTH=basic
TAVILY_MOCK=0

# --- DEMAND-DRIVEN INGESTION (query_templates.json) ---
# Automatic ingestion stops before remaining Tavily plan credits (all keys) drop
# below this reserve, so verification and live demos keep working. Remaining
# credits = Tavily /usage (which can lag for hours) + our own logged spend.
TAVILY_CREDIT_RESERVE=150
